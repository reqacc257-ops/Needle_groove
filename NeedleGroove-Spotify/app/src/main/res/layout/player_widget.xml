<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_background">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#F5EEE7"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/widget_previous" android:layout_width="64dp" android:layout_height="48dp" android:text="@string/previous_symbol" android:contentDescription="@string/previous_track" android:textColor="#F2BF6A" android:background="@android:color/transparent" />
        <Button android:id="@+id/widget_play" android:layout_width="64dp" android:layout_height="48dp" android:text="@string/play_symbol" android:contentDescription="@string/play_pause" android:textColor="#F2BF6A" android:background="@android:color/transparent" />
        <Button android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="48dp" android:text="@string/next_symbol" android:contentDescription="@string/next_track" android:textColor="#F2BF6A" android:background="@android:color/transparent" />
    </LinearLayout>
</LinearLayout>
